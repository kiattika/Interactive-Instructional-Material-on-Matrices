rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // This app's Express server (server/classroomFileStore.ts, server/livePollFileStore.ts,
    // using @google-cloud/firestore with Application Default Credentials / Admin privileges) is
    // the ONLY reader and writer of Firestore — no client-side code talks to Firestore directly.
    // Admin-privileged requests bypass these rules entirely, both against the emulator and real
    // Firestore, so this deny-all is just a safety net in case that ever changes.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
